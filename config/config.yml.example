http_address: ":8080"
ws_address: ":8081"
ws_public_url: "ws://localhost:8081/ws"
ws_allowed_origins: ["localhost:8080", "127.0.0.1:8080"]
ws_ticket_ttl: 30s
database_url: "postgres://chat:chat@localhost:5432/chat_api?sslmode=disable"
auth:
  jwt_secret: "replace-with-a-long-random-secret"
  jwt_ttl: 24h
redis:
  address: "localhost:6379"
  password: ""
  database: 0
  stream: "mini-hermes:events"
  publish_timeout: 2s
